<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.21.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- Receipt PDFs. Keep 6.2.x: it is MIT; PDFsharp 6.5+ is AGPL-3.0 with a license check (fails at runtime). -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp brings 8.0.1, which has known advisories. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <!-- Rich text of questions (stem, passage, explanation): allow-list HTML incl. ruby for furigana/pinyin. -->
    <PackageVersion Include="HtmlSanitizer" Version="11.0.26" />
    <!-- Shared rate-limit counters between API replicas (docs/trien-khai.md#giám-sát-và-cảnh-báo). -->
    <PackageVersion Include="StackExchange.Redis" Version="2.13.23" />
    <!-- Traces and metrics over OTLP; off unless OTEL_EXPORTER_OTLP_ENDPOINT is set. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <!-- Error reporting (Sentry or self-hosted GlitchTip); off unless Sentry:Dsn is set. -->
    <PackageVersion Include="Sentry.AspNetCore" Version="7.0.1" />
    <PackageVersion Include="Sentry.Extensions.Hosting" Version="7.0.1" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
  </ItemGroup>
</Project>
