{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/src/Hosts/Konnyaku.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5080
    },
    {
      "name": "worker",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/src/Hosts/Konnyaku.Worker"
      ],
      "port": 5090
    },
    {
      "name": "site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "pnpm@10.34.9",
        "--dir",
        "frontend/apps/site",
        "dev"
      ],
      "port": 4000
    }
  ]
}
