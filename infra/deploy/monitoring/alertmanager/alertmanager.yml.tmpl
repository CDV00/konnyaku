# Rendered by start.sh; the email receiver's auth and the Telegram receiver are appended there when configured,
# so this receiver must stay the last block of the file.
global:
  smtp_smarthost: '${SMTP_HOST}:${SMTP_PORT}'
  smtp_from: '${ALERT_EMAIL_FROM}'
  smtp_require_tls: ${ALERT_SMTP_REQUIRE_TLS}
  resolve_timeout: 5m

route:
  receiver: ops
  group_by: [alertname, service]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: [severity="warning"]
      receiver: ops
      repeat_interval: 24h

# A critical alert of a service mutes the warnings of the same service (a dead API is also slow).
inhibit_rules:
  - source_matchers: [severity="critical"]
    target_matchers: [severity="warning"]
    equal: [service]

receivers:
- name: ops
  email_configs:
  - to: '${ALERT_EMAIL_TO}'
    send_resolved: true
    headers:
      Subject: '[Konnyaku ${ALERT_ENVIRONMENT}] {{ .Status | toUpper }} {{ .CommonLabels.alertname }} {{ .CommonLabels.service }}'
