# Copy to .env on the server (never commit .env), then append generated secrets:
#   cp .env.example .env && ./scripts/gen-secrets.sh >> .env && chmod 600 .env

# Tenants are served at {slug}.BASE_DOMAIN; DNS A records for BASE_DOMAIN and *.BASE_DOMAIN point to this server.
BASE_DOMAIN=konnyaku.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.com

# Images published by .github/workflows/deploy.yml (ghcr.io/<owner in lowercase>/konnyaku-*). IMAGE_TAG: a commit SHA or latest.
IMAGE_WEB=ghcr.io/OWNER/konnyaku-web
IMAGE_API=ghcr.io/OWNER/konnyaku-api
IMAGE_WORKER=ghcr.io/OWNER/konnyaku-worker
IMAGE_MIGRATOR=ghcr.io/OWNER/konnyaku-migrator
IMAGE_SIGNALING=ghcr.io/OWNER/konnyaku-signaling
IMAGE_TAG=latest

# --- Machine profile (docs/toi-uu-tai-nguyen.md: measurements and how to re-measure) ---
# Standard: 4 vCPU / 8 GB. Measured stack peak: ~0.9 GB under normal load, ~1.4 GB under stress; the rest is OS page cache.
WEB_REPLICAS=2
API_REPLICAS=2
WORKER_REPLICAS=1
API_RUNS_WORKER=false
# Node heap cap (MB) and container limits. .NET sizes its GC heap to 75 % of the container limit.
WEB_HEAP_MB=512
WEB_MEM_LIMIT=768m
API_MEM_LIMIT=512m
WORKER_MEM_LIMIT=256m
# Classroom and realtime sockets (Rust signaling, coturn): not garbage collected, the limit is only a safety net.
# ~210 KiB per person in a classroom, ~16 KiB per open tab on /rt.
SIGNALING_MEM_LIMIT=256m
COTURN_MEM_LIMIT=128m
# Redis: shared rate-limit counters (a few KB per active visitor IP) and pub/sub of realtime signals (nothing stored).
REDIS_MAXMEMORY=32mb
REDIS_MEM_LIMIT=64m
# Npgsql pool per module role and process (12 roles): (API_REPLICAS x DB_POOL_MAX + WORKER_REPLICAS x WORKER_DB_POOL_MAX) x 12
# must stay below PG_MAX_CONNECTIONS.
DB_POOL_MAX=6
WORKER_DB_POOL_MAX=3
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MEM_LIMIT=2g

# Small: 1-2 vCPU / 2 GB (test machines: Oracle Always Free, AWS t3.small). Replace the block above with:
# WEB_REPLICAS=1
# API_REPLICAS=1
# WORKER_REPLICAS=0
# API_RUNS_WORKER=true
# WEB_HEAP_MB=384
# WEB_MEM_LIMIT=640m
# API_MEM_LIMIT=384m
# WORKER_MEM_LIMIT=256m
# SIGNALING_MEM_LIMIT=96m
# COTURN_MEM_LIMIT=64m
# REDIS_MAXMEMORY=16mb
# REDIS_MEM_LIMIT=32m
# DB_POOL_MAX=6
# WORKER_DB_POOL_MAX=3
# PG_MAX_CONNECTIONS=80
# PG_SHARED_BUFFERS=128MB
# PG_EFFECTIVE_CACHE_SIZE=512MB
# PG_WORK_MEM=4MB
# PG_MAINTENANCE_WORK_MEM=64MB
# PG_MEM_LIMIT=512m
# BACKUP_MEM_LIMIT=128m
# BACKUP_PROCESS_MAX=1

# Web Push of notifications: VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY come from gen-secrets.sh (empty: push off). Contact
# given to the push services (Google, Mozilla, Apple) in every request; default mailto:ACME_EMAIL.
#VAPID_SUBJECT=mailto:ops@example.com

# Built-in classroom (WebRTC mesh). People per room; firewall: 3478 udp+tcp and the relay range udp (docs/trien-khai.md).
ROOM_CAPACITY=6
# Host name in TURN/STUN URLs (default BASE_DOMAIN). TURN_EXTERNAL_IP: only behind cloud NAT (public or public/private).
#TURN_HOST=turn.konnyaku.example.com
#TURN_EXTERNAL_IP=203.0.113.10
TURN_MIN_PORT=49160
TURN_MAX_PORT=49260

# --- Continuous backup (pgBackRest, service `backup`; docs/trien-khai.md#backup) ---
# S3-compatible object storage at ANOTHER provider than this server: Backblaze B2, Cloudflare R2, Wasabi, or the
# object storage of a Vietnamese cloud (Viettel, VNG, FPT, BizFly...). Empty BACKUP_S3_BUCKET: continuous backup OFF.
# Use a key restricted to this bucket. pgBackRest always talks HTTPS.
#   B2: BACKUP_S3_ENDPOINT=s3.<region>.backblazeb2.com  BACKUP_S3_REGION=<region, e.g. us-west-004>  BACKUP_S3_URI_STYLE=host
#   R2: BACKUP_S3_ENDPOINT=<account id>.r2.cloudflarestorage.com  BACKUP_S3_REGION=auto  BACKUP_S3_URI_STYLE=path
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_KEY_SECRET=
BACKUP_S3_URI_STYLE=path
BACKUP_S3_PORT=443
BACKUP_S3_VERIFY_TLS=y
# Folder inside the bucket (one per environment if staging and production share a bucket).
BACKUP_S3_PATH=/konnyaku
# BACKUP_CIPHER_PASS comes from gen-secrets.sh (client-side encryption). Keep a copy OUTSIDE the server.
# Restore to any moment of the last N days (full backups and WAL older than needed for that are expired).
BACKUP_RETENTION_DAYS=30
# Daily backup time in UTC (19:30 UTC = 02:30 in Vietnam): full on BACKUP_FULL_WEEKDAY (1 = Monday ... 7 = Sunday),
# differential the other days. Restore drill after the backup on BACKUP_DRILL_DAY of each month (0 = never).
BACKUP_TIME_UTC=19:30
BACKUP_FULL_WEEKDAY=7
BACKUP_DRILL_DAY=1
# WAL segments are closed at least this often (seconds) while there are writes: the most a lost server can cost.
PG_ARCHIVE_TIMEOUT=60
# Parallel upload processes, and the WAL queue past which WAL is dropped rather than filling the disk.
BACKUP_PROCESS_MAX=2
BACKUP_WAL_QUEUE_MAX=4GiB
# Backup service memory (drill included: a throw-away PostgreSQL with 32 MB of buffers). 2 GB profile: 128m.
BACKUP_MEM_LIMIT=256m

# Nightly pg_dump (scripts/backup.sh, second layer) on the host, mounted into the containers at /backups.
# Status files for monitoring are written to BACKUP_DIR/status (docs/trien-khai.md, "File trạng thái").
BACKUP_DIR=./backups
# Days of local dumps to keep.
BACKUP_KEEP_DAYS=7

# Email (SMTP of a transactional provider; SPF/DKIM in docs/trien-khai.md). Empty SMTP_HOST: emails wait in the queue.
# SMTP_SECURITY: Auto (STARTTLS when offered), StartTls (port 587), SslOnConnect (port 465), None (never in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=Auto
# Sender address on a domain whose SPF/DKIM authorize the provider. The display name shown is the center name.
SMTP_FROM_ADDRESS=no-reply@konnyaku.example.com
SMTP_FROM_NAME=Konnyaku

# Public-form captcha (self-hosted proof of work). CAPTCHA_KEY comes from gen-secrets.sh; keep it enabled on the Internet.
CAPTCHA_ENABLED=true

# --- Monitoring (docs/trien-khai.md#giám-sát-và-cảnh-báo; RAM in docs/toi-uu-tai-nguyen.md) ---
# Turn on: both lines below, then `docker compose up -d`. Off: comment them out (the apps stop exporting).
#COMPOSE_PROFILES=monitoring
#OTEL_ENDPOINT=http://alloy:4318
# Share of request traces kept (1 = all; 0.2 on busy servers). Errors are traced like any request.
OTEL_TRACES_RATIO=1
# Alerts by email through the SMTP settings above (SMTP_SECURITY=None only for a local Mailpit).
ALERT_EMAIL_TO=ops@example.com
#ALERT_EMAIL_FROM=alerts@konnyaku.example.com
ALERT_ENVIRONMENT=production
# Optional Telegram: bot token from @BotFather, chat id of the ops group (negative number for groups).
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# Thresholds: p95 of API requests and of pages (seconds), hours without a successful backup.
ALERT_API_P95_SECONDS=1.5
ALERT_SITE_P95_SECONDS=3
BACKUP_MAX_AGE_HOURS=26
# Host directory of the *.prom status files of the backup jobs, read by node-exporter (default BACKUP_DIR/status).
#METRICS_TEXTFILE_DIR=./backups/status
# Public URL probed through Caddy (availability + certificate expiry). Default: https://admin.BASE_DOMAIN/api/health
#PROBE_PUBLIC_URL=
# Retention: metrics, logs, traces.
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=4GB
LOKI_RETENTION=168h
TEMPO_RETENTION=72h
# Grafana: https://admin.BASE_DOMAIN/grafana (user admin, GRAFANA_ADMIN_PASSWORD) or SSH tunnel to 127.0.0.1:3000.
GRAFANA_LOCAL_PORT=3000
# Memory limits of the monitoring containers, standard machine (8 GB). Small machine (2 GB): see the block below.
PROMETHEUS_MEM_LIMIT=512m
LOKI_MEM_LIMIT=384m
TEMPO_MEM_LIMIT=384m
GRAFANA_MEM_LIMIT=256m
ALLOY_MEM_LIMIT=256m
ALERTMANAGER_MEM_LIMIT=64m
CADVISOR_MEM_LIMIT=128m
NODE_EXPORTER_MEM_LIMIT=48m
POSTGRES_EXPORTER_MEM_LIMIT=48m
BLACKBOX_MEM_LIMIT=48m
# Go garbage-collector targets (~70-75 % of the limits above; Go does not read container limits by itself).
TEMPO_GOMEMLIMIT=280MiB
LOKI_GOMEMLIMIT=280MiB
GRAFANA_GOMEMLIMIT=180MiB
ALLOY_GOMEMLIMIT=180MiB
PROMETHEUS_GOMEMLIMIT=380MiB
# Small machine (2 GB): better run monitoring on a second VPS (docs/toi-uu-tai-nguyen.md). If it must run here:
# PROMETHEUS_MEM_LIMIT=256m
# PROMETHEUS_RETENTION=7d
# LOKI_MEM_LIMIT=192m
# LOKI_RETENTION=72h
# TEMPO_MEM_LIMIT=192m
# TEMPO_RETENTION=24h
# GRAFANA_MEM_LIMIT=160m
# ALLOY_MEM_LIMIT=160m
# TEMPO_GOMEMLIMIT=140MiB
# LOKI_GOMEMLIMIT=140MiB
# GRAFANA_GOMEMLIMIT=120MiB
# ALLOY_GOMEMLIMIT=120MiB
# PROMETHEUS_GOMEMLIMIT=190MiB
# OTEL_TRACES_RATIO=0.2

# Error reports (Sentry, or self-hosted GlitchTip: same SDK). Empty = off. One DSN for api/worker/web, or a separate
# project for the web app with SENTRY_WEB_DSN.
SENTRY_DSN=
#SENTRY_WEB_DSN=
SENTRY_ENVIRONMENT=production
