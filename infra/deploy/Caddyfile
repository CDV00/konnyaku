# Every tenant lives on its own host ({slug}.BASE_DOMAIN, later custom domains), so certificates are issued
# on demand (HTTP-01) the first time a host is visited, and only after the web app confirms the host is a tenant
# or the platform console host (admin.BASE_DOMAIN, see KONNYAKU_ADMIN_HOST of the web service).
# DNS: A/AAAA records for BASE_DOMAIN and *.BASE_DOMAIN point to this server (Cloudflare: "DNS only").
# Caddy is the edge: it ignores X-Forwarded-For sent by clients and sets it to the real client IP.

{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://web:3000/api/internal/tls-ask
	}
	# Request rate, errors and latency for Prometheus (monitoring profile), served on :2020 below.
	metrics
}

(web) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	request_body {
		max_size 10MB
	}

	# Grafana (monitoring profile) on the platform admin host only, behind Grafana's own login.
	@grafana {
		host admin.{$BASE_DOMAIN}
		path /grafana /grafana/*
	}
	handle @grafana {
		reverse_proxy grafana:3000
	}

	# Signaling of the built-in classroom (WebSocket /rtc/ws), on every tenant host.
	handle /rtc/* {
		reverse_proxy signaling:5100
	}

	# Realtime socket of every signed-in tab (inbox signals; doc 10.9), same service, on every tenant host. The socket
	# carries ids only; Caddy keeps it open as long as both ends do (the service pings every 20 s).
	handle /rt {
		reverse_proxy signaling:5100
	}

	handle {
		# Internal endpoints (certificate checks) are not public.
		@internal path /api/internal/*
		respond @internal 404

		# One upstream per web replica: Docker DNS returns all of them (caddy/web-upstreams.caddy). During a rolling
		# deploy scripts/deploy.sh switches to a static list without the replica it is about to stop (graceful reload),
		# so no request is sent to a replica that is going away. A replica that refuses connections anyway is retried
		# on another one for up to 10 s, and skipped for 10 s after 3 failures (one failure does not take a healthy
		# replica out). Idle upstream connections are closed by Caddy after 3 s, always before web closes them (it keeps
		# them 130 s), so a request is never sent on a connection web is closing.
		reverse_proxy {
			import /etc/caddy/upstreams/web-upstreams.caddy
			lb_policy round_robin
			lb_try_duration 10s
			fail_duration 10s
			max_fails 3
			transport http {
				keepalive 3s
			}
		}
	}
}

https:// {
	tls {
		on_demand
	}
	import web
}

http:// {
	redir https://{host}{uri} permanent
}

# Prometheus scrapes caddy:2020/metrics on the internal network; the port is not published.
:2020 {
	metrics
}
